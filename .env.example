# Endereço opcional para persistência local
MURALHA_DB_PATH=./data/muralha.sqlite3

# Pasta EXTERNA ao repositório com os gabaritos privados.
# Um arquivo <challenge_id>.json por desafio. Consulte docs/PRIVATE_EVALUATION.md.
MURALHA_GOLDEN_DIR=./private_oracles

# Testes ocultos por desafio em <MURALHA_PRIVATE_TESTS_DIR>/<challenge_id>/tests/
MURALHA_PRIVATE_TESTS_DIR=./private_tests

# Execução de código submetido está desativada por padrão. Só habilite em worker isolado.
MURALHA_ENABLE_SANDBOX=false
MURALHA_DOCKER_IMAGE=muralha-test-runner:py312
